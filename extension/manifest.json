{
  "manifest_version": 3,
  "name": "Chrome Anti-Ragebait",
  "version": "0.2.0",
  "description": "Sembunyikan ragebait dan unggahan dengan istilah politik dari Beranda X.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Anti-Ragebait",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "css": ["feed.css"],
      "js": ["rules.js", "feed.js"],
      "run_at": "document_start"
    }
  ]
}
