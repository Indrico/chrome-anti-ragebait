{
  "manifest_version": 3,
  "name": "Anti-Ragebait",
  "version": "0.8.1",
  "description": "Saring ragebait, politik, umpatan, dan unggahan centang biru di X, Facebook, Instagram, dan Threads.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Anti-Ragebait",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://facebook.com/*", "https://www.facebook.com/*",
        "https://instagram.com/*", "https://www.instagram.com/*",
        "https://threads.com/*", "https://www.threads.com/*"
      ],
      "css": ["feed.css"],
      "js": ["settings.js", "political-names.js", "rules.js", "site-adapters.js", "feed.js"],
      "run_at": "document_start"
    }
  ]
}
