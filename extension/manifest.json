{
  "manifest_version": 3,
  "name": "Chrome Anti-Ragebait",
  "version": "0.7.0",
  "description": "Saring ragebait, politik, dan umpatan di X, Facebook, Instagram, dan Threads.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Anti-Ragebait",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://facebook.com/*", "https://www.facebook.com/*",
        "https://instagram.com/*", "https://www.instagram.com/*",
        "https://threads.com/*", "https://www.threads.com/*"
      ],
      "css": ["feed.css"],
      "js": ["political-names.js", "rules.js", "site-adapters.js", "feed.js"],
      "run_at": "document_start"
    }
  ]
}
