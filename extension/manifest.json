{
  "manifest_version": 3,
  "name": "Chrome Anti-Ragebait",
  "version": "0.1.0",
  "description": "Sembunyikan unggahan yang diduga ragebait dari Beranda X berbahasa Indonesia.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "action": {
    "default_title": "Anti-Ragebait",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "css": ["feed.css"],
      "js": ["rules.js", "feed.js"],
      "run_at": "document_start"
    }
  ]
}
